{
  "name": "@openknots/terminal-ui",
  "version": "0.1.0",
  "description": "Beautiful terminal-like UI components for the web. Build CLI experiences in React.",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-braces.mjs && next build",
    "start": "next start",
    "lint": "pnpm exec eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/project-contract.test.mjs",
    "test:smoke": "node --test tests/project-contract.test.mjs",
    "format": "prettier --write .",
    "security:backport": "node scripts/verify-braces.mjs"
  },
  "keywords": [
    "terminal",
    "cli",
    "ui",
    "components",
    "react",
    "nextjs",
    "openclaw"
  ],
  "author": "OpenKnots",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "braces": "file:vendor/braces-3.0.3.tgz"
  },
  "pnpm": {
    "overrides": {
      "braces": "file:vendor/braces-3.0.3.tgz"
    }
  }
}
